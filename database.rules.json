{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "drivers": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "availableSeats": {
          ".write": "auth != null"
        }
      }
    },
    "bookings": {
      ".read": "auth != null",
      "$key": {
        ".write": "auth != null"
      }
    },
    "conversations": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "messages": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "students": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "onlineStatus": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
