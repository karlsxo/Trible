# Firebase Web App credentials
# Find these in: Firebase Console → Project Settings → General → Your apps → Web app → SDK setup
VITE_FIREBASE_API_KEY=your_api_key_here # Firebase API key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com # Firebase Auth domain
VITE_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com # Realtime Database URL
VITE_FIREBASE_PROJECT_ID=your_project_id_here # Firebase project ID
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app # Firebase storage bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here # Firebase sender ID
VITE_FIREBASE_APP_ID=your_app_id_here # Firebase app ID
